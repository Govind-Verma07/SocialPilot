# --- API Backend Base URL ---
# For Local Development:
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# For Vercel Production Deployment:
# Add this variable in Vercel Dashboard -> Project Settings -> Environment Variables:
# Key:   VITE_API_BASE_URL
# Value: https://socialpilot-859y.onrender.com/api/v1
VITE_API_BASE_URL=https://socialpilot-859y.onrender.com/api/v1
