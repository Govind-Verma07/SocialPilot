ALLOWED_ORIGINS=https://socialpilot-frontend.onrender.com,https://socialpilot-859y.onrender.com,http://localhost:5173,http://localhost:3000
FRONTEND_URL=https://socialpilot-frontend.onrender.com

# --- Render Deployment Backend Base URL ---
RENDER_EXTERNAL_URL=https://socialpilot-859y.onrender.com

