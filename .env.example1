# ==============================================================================
# SocialPilot - Production Environment Variables for Render Deployment
# File: .env.example1
#
# Instructions:
# 1. Copy these key-value pairs into the "Environment Variables" tab of your
#    Render Web Service (or Background Worker).
# 2. Render backend URL is configured as: https://socialpilot-859y.onrender.com
# 3. Replace "https://socialpilot-frontend.onrender.com" with your deployed frontend URL.
# ==============================================================================

# --- Application ---
PYTHON_VERSION=3.11.9
APP_ENV=production
APP_NAME=SocialPilot API
API_V1_PREFIX=/api/v1

# --- PostgreSQL Database (Supabase / Render PostgreSQL) ---
# Replace with your production connection string if different
DATABASE_URL=postgresql://postgres.hhmudxpgjhcvjptqcwii:Govindsocialpilot@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase Client Credentials ---
VITE_SUPABASE_URL=https://hhmudxpgjhcvjptqcwii.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_N2nBLRs1HRm4fuQbPZSQjw_oDzNhB4C

# --- MongoDB (Metadata & Analytics) ---
MONGODB_URI=mongodb+srv://socialpilotuser:Govind%401234@cluster0.mshdswu.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=socialpilot

# --- JWT Authentication ---
JWT_SECRET_KEY=b597ca80335043efa267cca48142dea192ac8eb9190e6941e4ae488cc00aa1dc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS & Client Access ---
