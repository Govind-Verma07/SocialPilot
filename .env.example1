# --- Redis & Celery Background Worker on Render ---
# Option A (Recommended on Render): If using a Render Redis service within the same region:
# Use the "Internal Redis URL" provided in your Render Redis dashboard:
# e.g., redis://red-xxxxxxxxxxxxxxxx:6379
REDIS_URL=redis://red-xxxxxxxxxxxxxxxx:6379/0
CELERY_BROKER_URL=redis://red-xxxxxxxxxxxxxxxx:6379/0
CELERY_RESULT_BACKEND=redis://red-xxxxxxxxxxxxxxxx:6379/0

# Option B: If using Upstash or External Redis with SSL/TLS (rediss://):
# REDIS_URL=rediss://default:your-redis-password@your-redis-host.upstash.io:6379/0
# CELERY_BROKER_URL=rediss://default:your-redis-password@your-redis-host.upstash.io:6379/0
# CELERY_RESULT_BACKEND=rediss://default:your-redis-password@your-redis-host.upstash.io:6379/0
